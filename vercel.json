{
  "version": 2,
  "services": {
    "be": {
      "root": "BE/",
      "runtime": "container",
      "entrypoint": "Dockerfile"
    },
    "fe": {
      "root": "FE/",
      "runtime": "container",
      "entrypoint": "Dockerfile"
    }
  },
  "rewrites": [
    { "source": "/messages(.*)", "destination": { "service": "be" } },
    { "source": "/status", "destination": { "service": "be" } },
    { "source": "/(.*)", "destination": { "service": "fe" } }
  ]
}
